      "parameters": {
        "toolDescription": "Útil para buscar en internet contexto sobre ciberseguridad, noticias recientes, multas, resoluciones de la AEPD o jurisprudencia pública",
        "text": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Prompt__User_Message_', ``, 'string') }}",
        "options": {
          "systemMessage": "\"Eres un Documentalista Jurídico especializado en ciberseguridad. Tu tarea es recibir una consulta, buscar exhaustivamente en internet usando tu herramientas de búsqueda \"google_search\", y devolver un resumen claro de los hechos recientes, noticias, sanciones o resoluciones públicas relacionadas con el tema. No des consejos legales, limítate a exponer los hechos, las fuentes y los enlaces que encuentres de manera objetiva.\""
        }
